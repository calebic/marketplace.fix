<mah:MetroWindow x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="BeamNG Mod Marketplace Config Editor" Height="780" Width="1340"
        MinHeight="620" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Bahnschrift"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseNoneWindowStyle="True"
        ShowTitleBar="False"
        ShowMinButton="False"
        ShowMaxRestoreButton="False"
        ShowCloseButton="False"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============================================================ -->
            <!-- LEFT NAV RAIL                                                 -->
            <!-- ============================================================ -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="18,18,18,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Brand -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,2,0,0">
                        <Border Width="34" Height="34" CornerRadius="10"
                                Background="{DynamicResource AccentGradientBrush}">
                            <TextBlock Text="&#xE804;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="17" Foreground="{DynamicResource AccentForegroundBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="MARKETPLACE" FontWeight="Bold" FontSize="13"
                                       Foreground="{DynamicResource AppForegroundBrush}"/>
                            <TextBlock Text="Config Editor" FontSize="11"
                                       Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Quick stats -->
                    <StackPanel Grid.Row="1" Margin="0,26,0,0">
                        <TextBlock Text="OVERVIEW" Style="{StaticResource EyebrowTextStyle}" Margin="2,0,0,10"/>

                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="11" Padding="13,11" Margin="0,0,0,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Total configs" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock x:Name="StatTotal" Text="0" FontSize="22" FontWeight="Bold"
                                               Foreground="{DynamicResource AppForegroundBrush}" Margin="0,1,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Width="36" Height="36" CornerRadius="10" VerticalAlignment="Center"
                                        Background="{DynamicResource SelectionBrush}">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="11" Padding="13,11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Need fixing" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock x:Name="StatMissing" Text="0" FontSize="22" FontWeight="Bold"
                                               Foreground="{DynamicResource ErrorBrush}" Margin="0,1,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Width="36" Height="36" CornerRadius="10" VerticalAlignment="Center"
                                        Background="{DynamicResource MissBadgeBackgroundBrush}">
                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{DynamicResource ErrorBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Ready progress -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="11" Padding="13,11" Margin="0,9,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Ready" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock x:Name="StatReadyPct" Text="0%" FontSize="11" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" Foreground="{DynamicResource SuccessBrush}"/>
                                </Grid>
                                <Border Height="6" CornerRadius="3" Background="{DynamicResource InputBackgroundBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="ReadyFillColumn" Width="0*"/>
                                            <ColumnDefinition x:Name="ReadyRestColumn" Width="100*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Height="6" CornerRadius="3" Background="{DynamicResource AccentGradientBrush}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Settings / Help nav -->
                    <StackPanel Grid.Row="3" VerticalAlignment="Bottom">
                        <Separator Margin="0,0,0,10"/>
                        <Button x:Name="AutoFillSettingsButton" Style="{StaticResource NavButtonStyle}"
                                Click="AutoFillSettingsButton_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="Settings" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="HelpButton" Style="{StaticResource NavButtonStyle}"
                                Click="HelpButton_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="Help &amp; docs" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="11,9" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource AccentGradientBrush}">
                                    <TextBlock Text="ic" FontWeight="Bold" FontSize="12"
                                               Foreground="{DynamicResource AccentForegroundBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="@ic.ey" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="Discord support" FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- MAIN CONTENT                                                  -->
            <!-- ============================================================ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title bar (drag + window buttons) -->
                <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Vehicle Configs" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="22,0,0,0"
                               Foreground="{DynamicResource AppForegroundBrush}"/>
                    <Button Grid.Column="1" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                            Margin="0,0,6,0" Style="{StaticResource TitleBarButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click"/>
                    <Button Grid.Column="2" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                            Margin="0,0,14,0" Style="{StaticResource TitleBarDangerButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click"/>
                </Grid>

                <!-- Scan bar -->
                <Border Grid.Row="1" Padding="16" Margin="22,4,22,0"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="2,0,16,0">
                            <TextBlock Text="MODS FOLDER" Style="{StaticResource EyebrowTextStyle}"/>
                            <TextBlock Text="Where your mods live" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBox x:Name="ModsPathTextBox" Grid.Column="1" Margin="0,0,14,0" MinWidth="320"
                                 VerticalContentAlignment="Center" Height="38"
                                 mah:TextBoxHelper.Watermark="Select your BeamNG mods folder..."/>
                        <Button x:Name="BrowseButton" Grid.Column="2" Content="Browse" Width="112" Height="38"
                                Margin="0,0,10,0" Click="BrowseMods_Click"/>
                        <Button x:Name="ScanButton" Grid.Column="3" Content="Scan" Width="100" Height="38"
                                Style="{StaticResource AccentButtonStyle}" Click="ScanMods_Click"/>
                    </Grid>
                </Border>

                <!-- Workspace split -->
                <Grid Grid.Row="2" Margin="22,14,22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="340"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CONFIG LIST -->
                    <Border Grid.Column="0" Padding="16" Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="2,0,0,12">
                                <Rectangle Width="3" Height="17" RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentGradientBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Configs" FontSize="16" Style="{StaticResource SectionTitleTextBlockStyle}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBox x:Name="SearchTextBox" Grid.Row="1" Margin="0,0,0,10" Height="36"
                                     VerticalContentAlignment="Center" TextChanged="SearchTextBox_TextChanged"
                                     mah:TextBoxHelper.Watermark="Search mod, model, config, or name"
                                     ToolTip="Search mod, model, config, or name"/>

                            <WrapPanel Grid.Row="2" Margin="0,0,0,12">
                                <CheckBox x:Name="MissingOnlyCheckBox" Margin="0,0,16,0" VerticalAlignment="Center" Content="Missing only"
                                          Checked="FilterControl_Changed" Unchecked="FilterControl_Changed"/>
                                <CheckBox x:Name="GroupByModCheckBox" Margin="0,0,16,0" VerticalAlignment="Center" Content="Group by mod" IsChecked="True"
                                          Checked="GroupByModCheckBox_Changed" Unchecked="GroupByModCheckBox_Changed"/>
                                <CheckBox x:Name="MissingFirstCheckBox" VerticalAlignment="Center" Content="Missing first"
                                          Checked="SortControl_Changed" Unchecked="SortControl_Changed"/>
                            </WrapPanel>

                            <Grid Grid.Row="3">
                                <Border x:Name="EmptyStateContainer"
                                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="11" Padding="16,12"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                                   Foreground="{DynamicResource MutedForegroundBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="EmptyStateTextBlock" Text="No configs match your filters."
                                                   Foreground="{DynamicResource MutedForegroundBrush}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <DataGrid x:Name="ConfigsGrid"
                                          ItemsSource="{Binding Configs}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          SelectionMode="Single" SelectionUnit="FullRow"
                                          FocusVisualStyle="{x:Null}"
                                          SelectionChanged="ConfigsGrid_SelectionChanged"
                                          HeadersVisibility="Column" ColumnWidth="*"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                          VirtualizingPanel.ScrollUnit="Pixel"
                                          VirtualizingPanel.CacheLength="2"
                                          VirtualizingPanel.CacheLengthUnit="Page"
                                          ScrollViewer.CanContentScroll="True"
                                          EnableRowVirtualization="True" EnableColumnVirtualization="False"
                                          GridLinesVisibility="None"
                                          Foreground="{DynamicResource AppForegroundBrush}"
                                          Background="Transparent" BorderThickness="0" RowHeight="46">

                                    <DataGrid.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                                    </DataGrid.Resources>

                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="Padding" Value="10,6"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="Height" Value="32"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>

                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,4"/>
                                            <Setter Property="SnapsToDevicePixels" Value="True"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DataGridRow">
                                                        <!-- Outer wrapper carries the lift transform + fade-in -->
                                                        <Grid x:Name="RowRoot" RenderTransformOrigin="0.5,0.5">
                                                            <Grid.RenderTransform>
                                                                <TransformGroup>
                                                                    <TranslateTransform x:Name="LiftTx" X="0" Y="0"/>
                                                                </TransformGroup>
                                                            </Grid.RenderTransform>
                                                            <Border x:Name="RowBorder" Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                                                    CornerRadius="10" Padding="0">
                                                                <Border.Effect>
                                                                    <DropShadowEffect x:Name="RowShadow" BlurRadius="0" ShadowDepth="0" Opacity="0" Color="#000000"/>
                                                                </Border.Effect>
                                                                <SelectiveScrollingGrid>
                                                                    <SelectiveScrollingGrid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </SelectiveScrollingGrid.ColumnDefinitions>
                                                                    <SelectiveScrollingGrid.RowDefinitions>
                                                                        <RowDefinition Height="*"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </SelectiveScrollingGrid.RowDefinitions>
                                                                    <!-- Animated accent rail: height grows from center on hover/select -->
                                                                    <Border x:Name="AccentStrip" Grid.Column="0" Width="3" CornerRadius="2"
                                                                            Margin="4,0,0,0" VerticalAlignment="Center" Height="0"
                                                                            Background="{DynamicResource AccentGradientBrush}"/>
                                                                    <DataGridCellsPresenter Grid.Column="1"/>
                                                                    <DataGridDetailsPresenter Grid.Column="1" Grid.Row="1" Visibility="{TemplateBinding DetailsVisibility}"/>
                                                                </SelectiveScrollingGrid>
                                                            </Border>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <!-- Fade + rise in when the row is realized -->
                                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="RowRoot" Storyboard.TargetProperty="Opacity"
                                                                                         From="0" To="1" Duration="0:0:0.22"/>
                                                                        <DoubleAnimation Storyboard.TargetName="LiftTx" Storyboard.TargetProperty="Y"
                                                                                         From="6" To="0" Duration="0:0:0.22">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut"/>
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>

                                                            <!-- Hover: lift up slightly, soft shadow, faint fill, short rail -->
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                                <Trigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="LiftTx" Storyboard.TargetProperty="Y"
                                                                                             To="-2" Duration="0:0:0.16">
                                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetName="RowShadow" Storyboard.TargetProperty="BlurRadius"
                                                                                             To="14" Duration="0:0:0.16"/>
                                                                            <DoubleAnimation Storyboard.TargetName="RowShadow" Storyboard.TargetProperty="ShadowDepth"
                                                                                             To="3" Duration="0:0:0.16"/>
                                                                            <DoubleAnimation Storyboard.TargetName="RowShadow" Storyboard.TargetProperty="Opacity"
                                                                                             To="0.35" Duration="0:0:0.16"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.EnterActions>
                                                                <Trigger.ExitActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="LiftTx" Storyboard.TargetProperty="Y"
                                                                                             To="0" Duration="0:0:0.16"/>
                                                                            <DoubleAnimation Storyboard.TargetName="RowShadow" Storyboard.TargetProperty="BlurRadius"
                                                                                             To="0" Duration="0:0:0.16"/>
                                                                            <DoubleAnimation Storyboard.TargetName="RowShadow" Storyboard.TargetProperty="ShadowDepth"
                                                                                             To="0" Duration="0:0:0.16"/>
                                                                            <DoubleAnimation Storyboard.TargetName="RowShadow" Storyboard.TargetProperty="Opacity"
                                                                                             To="0" Duration="0:0:0.16"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.ExitActions>
                                                            </Trigger>

                                                            <!-- Selected: persistent fill, accent border, full rail -->
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                <Setter TargetName="AccentStrip" Property="Height" Value="22"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource SelectionForegroundBrush}"/>
                                                                <Trigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="AccentStrip" Storyboard.TargetProperty="Height"
                                                                                             From="0" To="22" Duration="0:0:0.2">
                                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.EnterActions>
                                                            </Trigger>

                                                            <MultiTrigger>
                                                                <MultiTrigger.Conditions>
                                                                    <Condition Property="IsSelected" Value="True"/>
                                                                    <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                                                </MultiTrigger.Conditions>
                                                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource SelectionForegroundBrush}"/>
                                                            </MultiTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGrid.RowStyle>

                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="8,4"/>
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource SelectionForegroundBrush}"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.CellStyle>

                                    <DataGrid.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.Panel>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel/>
                                                </ItemsPanelTemplate>
                                            </GroupStyle.Panel>
                                            <GroupStyle.ContainerStyle>
                                                <Style TargetType="{x:Type GroupItem}">
                                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                                <StackPanel>
                                                                    <ToggleButton x:Name="GroupHeaderToggle" IsChecked="False"
                                                                                  Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                                                                  Padding="0" Margin="0,0,0,4" HorizontalAlignment="Stretch"
                                                                                  HorizontalContentAlignment="Stretch" FocusVisualStyle="{x:Null}">
                                                                        <ToggleButton.Template>
                                                                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                                                <Border x:Name="GroupHeaderBackground"
                                                                                        Background="{DynamicResource SurfaceBrush}"
                                                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                                                        CornerRadius="10" Height="36" Padding="12,0" SnapsToDevicePixels="True">
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <!-- two chevrons toggled by visibility (no RotateTransform target) -->
                                                                                        <Grid Grid.Column="0" Width="10" Margin="0,0,10,0" VerticalAlignment="Center">
                                                                                            <Path x:Name="ChevronClosed" Data="M 0 0 L 5 4 L 0 8 Z"
                                                                                                  Fill="{DynamicResource MutedForegroundBrush}" Width="5" Height="8"
                                                                                                  Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                            <Path x:Name="ChevronOpen" Data="M 0 0 L 8 0 L 4 5 Z"
                                                                                                  Fill="{DynamicResource AccentBrush}" Width="8" Height="5"
                                                                                                  Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                                  Visibility="Collapsed"/>
                                                                                        </Grid>
                                                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                                                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                                                   Foreground="{DynamicResource AppForegroundBrush}"/>
                                                                                        <Border Grid.Column="2" Background="{DynamicResource StatusBadgeBackgroundBrush}"
                                                                                                CornerRadius="9" Padding="9,2" VerticalAlignment="Center">
                                                                                            <TextBlock Text="{Binding ItemCount, StringFormat={}{0} configs}" FontSize="11"
                                                                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                                                        </Border>
                                                                                    </Grid>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="GroupHeaderBackground" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                                                        <Setter TargetName="GroupHeaderBackground" Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}"/>
                                                                                    </Trigger>
                                                                                    <Trigger Property="IsChecked" Value="True">
                                                                                        <Setter TargetName="GroupHeaderBackground" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                                        <Setter TargetName="ChevronClosed" Property="Visibility" Value="Collapsed"/>
                                                                                        <Setter TargetName="ChevronOpen" Property="Visibility" Value="Visible"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </ToggleButton.Template>
                                                                    </ToggleButton>
                                                                    <ItemsPresenter x:Name="ItemsHost" Margin="0,0,0,2" Visibility="Collapsed"/>
                                                                </StackPanel>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger SourceName="GroupHeaderToggle" Property="IsChecked" Value="True">
                                                                        <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </GroupStyle.ContainerStyle>
                                        </GroupStyle>
                                    </DataGrid.GroupStyle>

                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="NAME" Width="*" MinWidth="240">
                                            <DataGridTemplateColumn.HeaderStyle>
                                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                    <Setter Property="Padding" Value="48,8,10,4"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTemplateColumn.HeaderStyle>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid VerticalAlignment="Center" Margin="0,2,0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Calm status dot: soft ring + center fill, not an alarm icon -->
                                                        <Border x:Name="StatusDotRing" Grid.Column="0"
                                                                Width="22" Height="22" CornerRadius="11"
                                                                Background="{DynamicResource OkBadgeBackgroundBrush}"
                                                                Margin="10,0,12,0" VerticalAlignment="Center">
                                                            <Ellipse x:Name="StatusDotCore" Width="8" Height="8"
                                                                     Fill="{DynamicResource SuccessBrush}"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Name + inline config key as a lighter trailing fragment -->
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding VehicleName}" VerticalAlignment="Center"
                                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding ConfigKey}" VerticalAlignment="Center"
                                                                       Margin="9,0,0,0" FontSize="11.5"
                                                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                                                       TextTrimming="CharacterEllipsis" Opacity="0.85"/>
                                                        </StackPanel>

                                                        <!-- Soft status pill -->
                                                        <Border x:Name="StatusPill" Grid.Column="2"
                                                                Background="{DynamicResource OkBadgeBackgroundBrush}"
                                                                BorderBrush="{DynamicResource OkBadgeBorderBrush}" BorderThickness="1"
                                                                CornerRadius="10" Padding="9,2" Margin="10,0,12,0" VerticalAlignment="Center">
                                                            <TextBlock x:Name="StatusPillText" Text="Ready" FontSize="10.5" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource OkBadgeForegroundBrush}"/>
                                                        </Border>
                                                    </Grid>

                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding HasMissing}" Value="True">
                                                            <Setter TargetName="StatusDotCore" Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                                            <Setter TargetName="StatusDotRing" Property="Background" Value="{DynamicResource MissBadgeBackgroundBrush}"/>
                                                            <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource MissBadgeBackgroundBrush}"/>
                                                            <Setter TargetName="StatusPill" Property="BorderBrush" Value="{DynamicResource MissBadgeBorderBrush}"/>
                                                            <Setter TargetName="StatusPillText" Property="Text" Value="{Binding MissingCountLabel}"/>
                                                            <Setter TargetName="StatusPillText" Property="Foreground" Value="{DynamicResource MissBadgeForegroundBrush}"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- CONFIG DETAILS -->
                    <Border Grid.Column="1" Margin="14,0,0,0" Padding="20" Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="3" Height="17" RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentGradientBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Config details" FontSize="16" Style="{StaticResource SectionTitleTextBlockStyle}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Auto Fill" Height="34" MinWidth="92" Padding="14,4" VerticalAlignment="Center" Click="AutoFillMissing_Click"/>
                                        <Button Content="&#xE74E;" Margin="8,0,0,0" Style="{StaticResource ToolbarIconButtonStyle}" VerticalAlignment="Center"
                                                FontFamily="Segoe MDL2 Assets" FontSize="14" ToolTip="Save (Ctrl+S)" Click="SaveChanges_Click"/>
                                        <Button Content="&#xE72C;" Margin="8,0,0,0" Style="{StaticResource ToolbarIconButtonStyle}" VerticalAlignment="Center"
                                                FontFamily="Segoe MDL2 Assets" FontSize="14" ToolTip="Reload (Ctrl+R)" Click="ReloadSelected_Click"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="ConfigPathText" Margin="0,8,0,12" Foreground="{DynamicResource MutedForegroundBrush}"
                                           FontSize="11.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

                                <!-- Summary stat strip -->
                                <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="11" Padding="14,11" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ConfigSummaryText" Foreground="{DynamicResource AppForegroundBrush}"
                                                   FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Border x:Name="UnsavedBadge" Grid.Column="1" Background="{DynamicResource StatusBadgeBackgroundBrush}"
                                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="12"
                                                Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                <TextBlock Text="Unsaved changes" Foreground="{DynamicResource AppForegroundBrush}" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Fields: two-column responsive grid -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Left column -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                        <TextBlock x:Name="BrandLabel" Text="Brand" Style="{StaticResource FormFieldLabelStyle}" Margin="2,0,0,4"/>
                                        <TextBox x:Name="BrandTextBox" Margin="0" TextChanged="FieldTextChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                        <TextBlock x:Name="CountryLabel" Text="Country" Style="{StaticResource FormFieldLabelStyle}" Margin="2,0,0,4"/>
                                        <TextBox x:Name="CountryTextBox" Margin="0" TextChanged="FieldTextChanged"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                                        <TextBlock x:Name="TypeLabel" Text="Type" Style="{StaticResource FormFieldLabelStyle}" Margin="2,0,0,4"/>
                                        <TextBox x:Name="TypeTextBox" Margin="0" TextChanged="FieldTextChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                                        <TextBlock x:Name="BodyStyleLabel" Text="Body Style" Style="{StaticResource FormFieldLabelStyle}" Margin="2,0,0,4"/>
                                        <TextBox x:Name="BodyStyleTextBox" Margin="0" TextChanged="FieldTextChanged"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                                        <TextBlock x:Name="ConfigTypeLabel" Text="Config Type" Style="{StaticResource FormFieldLabelStyle}" Margin="2,0,0,4"/>
                                        <TextBox x:Name="ConfigTypeTextBox" Margin="0" TextChanged="FieldTextChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                                        <TextBlock x:Name="ConfigurationLabel" Text="Configuration" Style="{StaticResource FormFieldLabelStyle}" Margin="2,0,0,4"/>
                                        <TextBox x:Name="ConfigurationTextBox" Margin="0" TextChanged="FieldTextChanged"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,12">
                                        <TextBlock x:Name="YearMinLabel" Text="Year Min" Style="{StaticResource FormFieldLabelStyle}" Margin="2,0,0,4"/>
                                        <mah:NumericUpDown x:Name="YearMinUpDown" Margin="0" Minimum="1900" Maximum="2200" Interval="1" ValueChanged="NumericFieldChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,12">
                                        <TextBlock x:Name="YearMaxLabel" Text="Year Max" Style="{StaticResource FormFieldLabelStyle}" Margin="2,0,0,4"/>
                                        <mah:NumericUpDown x:Name="YearMaxUpDown" Margin="0" Minimum="1900" Maximum="2200" Interval="1" ValueChanged="NumericFieldChanged"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,12">
                                        <TextBlock x:Name="ValueLabel" Text="Value" Style="{StaticResource FormFieldLabelStyle}" Margin="2,0,0,4"/>
                                        <mah:NumericUpDown x:Name="ValueUpDown" Margin="0" Minimum="0" Interval="100" ValueChanged="NumericFieldChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,12">
                                        <TextBlock x:Name="PopulationLabel" Text="Population" Style="{StaticResource FormFieldLabelStyle}" Margin="2,0,0,4"/>
                                        <mah:NumericUpDown x:Name="PopulationUpDown" Margin="0" Minimum="0" Maximum="1000000" Interval="10" ValueChanged="NumericFieldChanged"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,0,4">
                                        <TextBlock x:Name="InsuranceClassLabel" Text="Insurance Class" Style="{StaticResource FormFieldLabelStyle}" Margin="2,0,0,4"/>
                                        <ComboBox x:Name="InsuranceClassComboBox" Margin="0" Style="{StaticResource PresetComboBoxStyle}"
                                                  SelectionChanged="InsuranceClassComboBox_SelectionChanged">
                                            <ComboBoxItem Content="dailyDriver" IsSelected="True"/>
                                            <ComboBoxItem Content="commercial"/>
                                            <ComboBoxItem Content="prestige"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="5" Grid.Column="2" Margin="0,0,0,4">
                                        <TextBlock x:Name="PopulationPresetLabel" Text="Population Preset" Style="{StaticResource FormFieldLabelStyle}" Margin="2,0,0,4"/>
                                        <ComboBox x:Name="PopulationPresetComboBox" Margin="0" Style="{StaticResource PresetComboBoxStyle}"
                                                  SelectionChanged="PopulationPresetComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Custom" IsSelected="False"/>
                                            <ComboBoxItem Content="Ultra-rare (1-50)"/>
                                            <ComboBoxItem Content="Rare (50-200)"/>
                                            <ComboBoxItem Content="Uncommon (200-800)"/>
                                            <ComboBoxItem Content="Common (800-3000)"/>
                                            <ComboBoxItem Content="Very common (3000-10000)"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Status bar -->
                <Border Grid.Row="3" Padding="14,11" Margin="22,14,22,16"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="2,0,10,0"/>
                        <TextBlock x:Name="StatusTextBlock" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============================================================ -->
            <!-- SLIDE-IN OVERLAY (Help + Settings share one panel)           -->
            <!-- Spans the whole window; sits on top. Hidden by default.      -->
            <!-- ============================================================ -->
            <Grid x:Name="OverlayHost" Grid.Column="0" Grid.ColumnSpan="2"
                  Panel.ZIndex="100" Visibility="Collapsed">

                <!-- Dim backdrop; click to dismiss -->
                <Border x:Name="OverlayBackdrop" Background="#B3050608"/>
                <Rectangle x:Name="OverlayDismiss" Fill="Transparent" MouseLeftButtonDown="OverlayDismiss_Click"/>

                <!-- The sliding panel -->
                <Border x:Name="SlidePanel"
                        HorizontalAlignment="Right" Width="440"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                        RenderTransformOrigin="0,0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="SlideTransform" X="460"/>
                    </Border.RenderTransform>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ===== HERO HEADER (neon gradient band) ===== -->
                        <Border Grid.Row="0" Height="96">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1622D3EE" Offset="0"/>
                                    <GradientStop Color="#0A0B0F" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid Margin="24,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="12" VerticalAlignment="Center"
                                        Background="{DynamicResource AccentGradientBrush}">
                                    <TextBlock x:Name="PanelHeaderIcon" Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="20" Foreground="{DynamicResource AccentForegroundBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="PanelHeaderTitle" Text="Settings" FontSize="19" FontWeight="Bold"
                                               Foreground="{DynamicResource AppForegroundBrush}"/>
                                    <TextBlock x:Name="PanelHeaderSubtitle" Text="Preferences and auto-fill defaults"
                                               FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                        Style="{StaticResource ToolbarIconButtonStyle}" VerticalAlignment="Center"
                                        ToolTip="Close (Esc)" Click="OverlayDismiss_Click"/>
                            </Grid>
                        </Border>

                        <!-- ===== BODY ===== -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20,24,20">
                            <Grid>
                                <!-- SETTINGS CONTENT -->
                                <StackPanel x:Name="SettingsContent">
                                    <TextBlock Text="APPLICATION" Style="{StaticResource EyebrowTextStyle}" Margin="2,0,0,10"/>

                                    <!-- Toggle rows as light-up cards -->
                                    <Border x:Name="ThemeRow" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource SelectionBrush}" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE793;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Dark mode" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="Neon dark theme, or clean light." FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <mah:ToggleSwitch x:Name="ThemeToggleSwitch" Grid.Column="2" IsOn="False" Width="70" Height="30" VerticalAlignment="Center" Toggled="ThemeToggleSwitch_Toggled"/>
                                        </Grid>
                                    </Border>

                                    <Border x:Name="BackupRow" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource SelectionBrush}" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Backup before save" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="Write a .bak copy before the first edit." FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <mah:ToggleSwitch x:Name="BackupToggleSwitch" Grid.Column="2" IsOn="False" Width="70" Height="30" VerticalAlignment="Center" Toggled="BackupToggleSwitch_Toggled"/>
                                        </Grid>
                                    </Border>

                                    <Border x:Name="VehiclesRow" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,18">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource SelectionBrush}" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE804;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Input into 'Vehicles'" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="Mirror saved files into the vehicles folder." FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <mah:ToggleSwitch x:Name="VehiclesToggleSwitch" Grid.Column="2" IsOn="False" Width="70" Height="30" VerticalAlignment="Center" Toggled="VehiclesToggleSwitch_Toggled"/>
                                        </Grid>
                                    </Border>

                                    <!-- Auto-fill defaults card -->
                                    <Grid Margin="2,0,0,10">
                                        <TextBlock Text="AUTO-FILL DEFAULTS" Style="{StaticResource EyebrowTextStyle}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Ticked rows fill on Auto Fill" FontSize="10.5" Foreground="{DynamicResource MutedForegroundBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="6">
                                        <StackPanel>
                                            <Grid Margin="8,7">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <CheckBox x:Name="AutoBrandCheckBox" VerticalAlignment="Center" Content="Brand"/>
                                                <TextBox Grid.Column="1" x:Name="AutoBrandTextBox" Margin="0" mah:TextBoxHelper.Watermark="e.g. Custom"/>
                                            </Grid>
                                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="8,0" Opacity="0.5"/>
                                            <Grid Margin="8,7">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <CheckBox x:Name="AutoCountryCheckBox" VerticalAlignment="Center" Content="Country"/>
                                                <TextBox Grid.Column="1" x:Name="AutoCountryTextBox" Margin="0" mah:TextBoxHelper.Watermark="e.g. United States"/>
                                            </Grid>
                                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="8,0" Opacity="0.5"/>
                                            <Grid Margin="8,7">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <CheckBox x:Name="AutoTypeCheckBox" VerticalAlignment="Center" Content="Type"/>
                                                <TextBox Grid.Column="1" x:Name="AutoTypeTextBox" Margin="0" mah:TextBoxHelper.Watermark="e.g. Car"/>
                                            </Grid>
                                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="8,0" Opacity="0.5"/>
                                            <Grid Margin="8,7">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <CheckBox x:Name="AutoBodyStyleCheckBox" VerticalAlignment="Center" Content="Body Style"/>
                                                <TextBox Grid.Column="1" x:Name="AutoBodyStyleTextBox" Margin="0" mah:TextBoxHelper.Watermark="e.g. Sedan"/>
                                            </Grid>
                                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="8,0" Opacity="0.5"/>
                                            <Grid Margin="8,7">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <CheckBox x:Name="AutoConfigTypeCheckBox" VerticalAlignment="Center" Content="Config Type"/>
                                                <TextBox Grid.Column="1" x:Name="AutoConfigTypeTextBox" Margin="0" mah:TextBoxHelper.Watermark="e.g. Custom"/>
                                            </Grid>
                                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="8,0" Opacity="0.5"/>
                                            <Grid Margin="8,7">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <CheckBox x:Name="AutoYearCheckBox" VerticalAlignment="Center" Content="Default Year"/>
                                                <mah:NumericUpDown Grid.Column="1" x:Name="AutoYearUpDown" Margin="0" Minimum="1900" Maximum="2200" Interval="1"/>
                                            </Grid>
                                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="8,0" Opacity="0.5"/>
                                            <Grid Margin="8,7">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <CheckBox x:Name="AutoValueCheckBox" VerticalAlignment="Center" Content="Value"/>
                                                <mah:NumericUpDown Grid.Column="1" x:Name="AutoValueUpDown" Margin="0" Minimum="0" Interval="100"/>
                                            </Grid>
                                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="8,0" Opacity="0.5"/>
                                            <Grid Margin="8,7">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <CheckBox x:Name="AutoPopulationCheckBox" VerticalAlignment="Center" Content="Population"/>
                                                <mah:NumericUpDown Grid.Column="1" x:Name="AutoPopulationUpDown" Margin="0" Minimum="0" Maximum="1000000" Interval="10"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- HELP CONTENT -->
                                <StackPanel x:Name="HelpContent" Visibility="Collapsed">
                                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="15,13" Margin="0,0,0,18">
                                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="12.5" LineHeight="19"
                                                   Text="This tool scans BeamNG mods for marketplace info JSON files and .pc configs, highlights missing marketplace fields, and lets you save corrected values so vehicles show up in Career Marketplace."/>
                                    </Border>

                                    <TextBlock Text="QUICK START" Style="{StaticResource EyebrowTextStyle}" Margin="2,0,0,10"/>
                                    <StackPanel Margin="0,0,0,18">
                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource SelectionBrush}" VerticalAlignment="Top">
                                                <TextBlock Text="1" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource AppForegroundBrush}" FontSize="12.5" Text="Select your Mods folder and click Scan."/>
                                        </Grid>
                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource SelectionBrush}" VerticalAlignment="Top">
                                                <TextBlock Text="2" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource AppForegroundBrush}" FontSize="12.5" Text="Pick a config from the list and fill missing fields on the right."/>
                                        </Grid>
                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource SelectionBrush}" VerticalAlignment="Top">
                                                <TextBlock Text="3" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource AppForegroundBrush}" FontSize="12.5" Text="Choose Insurance Class and verify Year, Value, and Population."/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource SelectionBrush}" VerticalAlignment="Top">
                                                <TextBlock Text="4" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource AppForegroundBrush}" FontSize="12.5" Text="Click Save. Enable Input into 'Vehicles' if marketplace visibility still fails."/>
                                        </Grid>
                                    </StackPanel>

                                    <TextBlock Text="OPTIONS" Style="{StaticResource EyebrowTextStyle}" Margin="2,0,0,10"/>
                                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="14,4" Margin="0,0,0,18">
                                        <StackPanel>
                                            <StackPanel Margin="0,10,0,10">
                                                <TextBlock Text="Missing only" FontWeight="SemiBold" FontSize="12.5"/>
                                                <TextBlock Text="Shows only configs that still have missing fields." FontSize="11.5" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.5"/>
                                            <StackPanel Margin="0,10,0,10">
                                                <TextBlock Text="Group by mod" FontWeight="SemiBold" FontSize="12.5"/>
                                                <TextBlock Text="Groups rows by mod package name." FontSize="11.5" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.5"/>
                                            <StackPanel Margin="0,10,0,10">
                                                <TextBlock Text="Missing first" FontWeight="SemiBold" FontSize="12.5"/>
                                                <TextBlock Text="Sorts configs with missing values to the top." FontSize="11.5" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.5"/>
                                            <StackPanel Margin="0,10,0,10">
                                                <TextBlock Text="Backup before save" FontWeight="SemiBold" FontSize="12.5"/>
                                                <TextBlock Text="Creates a .bak copy before the first write." FontSize="11.5" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.5"/>
                                            <StackPanel Margin="0,10,0,10">
                                                <TextBlock Text="Input into 'Vehicles'" FontWeight="SemiBold" FontSize="12.5"/>
                                                <TextBlock Text="Mirrors saved info, matching .pc, and preview images into the vehicles folder sibling to your mods folder." FontSize="11.5" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="KEYBOARD" Style="{StaticResource EyebrowTextStyle}" Margin="2,0,0,10"/>
                                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,18">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Focus search" VerticalAlignment="Center" FontSize="12.5"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Border Style="{StaticResource KeyCapStyle}"><TextBlock Text="Ctrl"/></Border>
                                                    <TextBlock Text="+" VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" Margin="4,0"/>
                                                    <Border Style="{StaticResource KeyCapStyle}"><TextBlock Text="F"/></Border>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Save config" VerticalAlignment="Center" FontSize="12.5"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Border Style="{StaticResource KeyCapStyle}"><TextBlock Text="Ctrl"/></Border>
                                                    <TextBlock Text="+" VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" Margin="4,0"/>
                                                    <Border Style="{StaticResource KeyCapStyle}"><TextBlock Text="S"/></Border>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Reload config" VerticalAlignment="Center" FontSize="12.5"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Border Style="{StaticResource KeyCapStyle}"><TextBlock Text="Ctrl"/></Border>
                                                    <TextBlock Text="+" VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" Margin="4,0"/>
                                                    <Border Style="{StaticResource KeyCapStyle}"><TextBlock Text="R"/></Border>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Auto-fill missing" VerticalAlignment="Center" FontSize="12.5"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Border Style="{StaticResource KeyCapStyle}"><TextBlock Text="Ctrl"/></Border>
                                                    <TextBlock Text="+" VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" Margin="4,0"/>
                                                    <Border Style="{StaticResource KeyCapStyle}"><TextBlock Text="A"/></Border>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Move selection" VerticalAlignment="Center" FontSize="12.5"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Border Style="{StaticResource KeyCapStyle}"><TextBlock Text="&#x2191;"/></Border>
                                                    <Border Style="{StaticResource KeyCapStyle}" Margin="4,0,0,0"><TextBlock Text="&#x2193;"/></Border>
                                                </StackPanel>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Close this panel" VerticalAlignment="Center" FontSize="12.5"/>
                                                <Border Grid.Column="1" Style="{StaticResource KeyCapStyle}"><TextBlock Text="Esc"/></Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="FIELD GUIDE" Style="{StaticResource EyebrowTextStyle}" Margin="2,0,0,10"/>
                                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="15,13" Margin="0,0,0,18">
                                        <StackPanel>
                                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="12" Text="Insurance Class values: dailyDriver, commercial, prestige."/>
                                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="12" Text="Region is force-set to northAmerica when saving."/>
                                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="12" Text="Population presets are shortcuts only; Custom means your numeric value is used."/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="TROUBLESHOOTING" Style="{StaticResource EyebrowTextStyle}" Margin="2,0,0,10"/>
                                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="15,13">
                                        <StackPanel>
                                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="12" Text="Vehicle still not in marketplace: save again with Input into 'Vehicles' enabled."/>
                                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="12" Text="Mirror warning about vehicles path: verify mods and vehicles are sibling folders under the same BeamNG root."/>
                                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="12" Text="If fields stay marked missing, check for empty values and invalid year range."/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <!-- ===== FOOTER (Settings only) ===== -->
                        <Border x:Name="PanelFooter" Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
                            <Grid>
                                <Button Content="Cancel" MinWidth="92" HorizontalAlignment="Left" Click="OverlayDismiss_Click"/>
                                <Button Content="Save changes" MinWidth="120" HorizontalAlignment="Right"
                                        Style="{StaticResource AccentButtonStyle}" Click="AutoFillSettingsSave_Click"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</mah:MetroWindow>
