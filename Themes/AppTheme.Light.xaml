<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light counterpart: soft slate canvas, white cards, same cyan/teal neon accent -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#EEF1F6" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#E2E7EF" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F6F8FB" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputForegroundBrush" Color="#0F1A2A" />
    <SolidColorBrush x:Key="AppForegroundBrush" Color="#0D1726" />
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#5A6678" />
    <SolidColorBrush x:Key="FormLabelBrush" Color="#48566B" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D3DAE5" />
    <SolidColorBrush x:Key="StrongBorderBrush" Color="#BCC6D4" />

    <SolidColorBrush x:Key="AccentBrush" Color="#0EA5BE" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#220EA5BE" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0EA5BE" Offset="0" />
        <GradientStop Color="#14B8A6" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SuccessBrush" Color="#0E9F6E" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#E11D48" />
    <SolidColorBrush x:Key="VioletBrush" Color="#7C3AED" />

    <SolidColorBrush x:Key="SelectionBrush" Color="#D4F4F8" />
    <SolidColorBrush x:Key="SelectionForegroundBrush" Color="#0A3A42" />

    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#E5EAF1" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#EDF1F7" />
    <SolidColorBrush x:Key="DangerButtonBackgroundBrush" Color="#FBE9ED" />
    <SolidColorBrush x:Key="HoverBrush" Color="#E6ECF4" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="StatusBadgeBackgroundBrush" Color="#DEF3F6" />
    <SolidColorBrush x:Key="GridHeaderBackgroundBrush" Color="#E8EDF4" />

    <SolidColorBrush x:Key="OkBadgeBackgroundBrush" Color="#E2F7EF" />
    <SolidColorBrush x:Key="OkBadgeBorderBrush" Color="#A7E3CC" />
    <SolidColorBrush x:Key="OkBadgeForegroundBrush" Color="#0E7A53" />
    <SolidColorBrush x:Key="MissBadgeBackgroundBrush" Color="#FCE7EC" />
    <SolidColorBrush x:Key="MissBadgeBorderBrush" Color="#F1B5C2" />
    <SolidColorBrush x:Key="MissBadgeForegroundBrush" Color="#C01643" />
</ResourceDictionary>
